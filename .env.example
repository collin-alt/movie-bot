# Get this from @BotFather on Telegram after creating your bot
BOT_TOKEN=your_bot_token_here

# Get a free API key at https://www.themoviedb.org/settings/api
TMDB_API_KEY=your_tmdb_api_key_here

# Optional: restrict the bot to only react in this specific group.
# Leave blank to have it react in any group/chat it's added to.
# To find your group's chat_id, add @RawDataBot to the group temporarily,
# or check the logs after the bot receives a message.
GROUP_CHAT_ID=
